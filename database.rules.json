{
  "rules": {
    ".read": false,
    ".write": false,
    "tg_files": { ".indexOn": ["owner"] },
    "txns": { ".indexOn": ["status", "user_id", "created_at", "reseller_id", "upi_record_id"] },
    "earnings": { ".indexOn": ["ts", "app_id", "reseller_id"] },
    "upi_ledger": { ".indexOn": ["ts", "reseller_id"] },
    "licenses": { ".indexOn": ["chat_id", "app_id", "reseller_id"] },
    "logs": { ".indexOn": ["ts"] },
    "logs_sec": {
      "$section": { ".indexOn": ["ts"] }
    },
    "rewards": { ".indexOn": ["user_id", "notify_at", "created_at"] },
    "wallet_tx": { ".indexOn": ["user_id", "ts"] },
    "withdrawals": { ".indexOn": ["user_id", "status"] },
    "referral_earnings": { ".indexOn": ["referrer"] },
    "broadcasts": { ".indexOn": ["status"] },
    "seller_earnings": { ".indexOn": ["seller_id"] },
    "seller_withdrawals": { ".indexOn": ["seller_id", "status"] },
    "submissions": { ".indexOn": ["status", "seller_id"] },
    "app_drafts": { ".indexOn": ["seller_id"] },
    "banned": { ".indexOn": ["ts"] }
  }
}
