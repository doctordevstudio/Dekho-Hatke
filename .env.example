# ---------- required ----------
SECRET_KEY=change-me-to-a-long-random-string
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# paste the whole service-account JSON on ONE line (Render: Environment -> add variable)
FIREBASE_CREDENTIALS_JSON=
BOT_TOKEN=123456:ABC-your-bot-token

# first admin (only used when the database has no admin yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword1

# optional second admin: can do everything except deleting (created / password synced from env on every start)
ADMIN2_USERNAME=
ADMIN2_PASSWORD=
ADMIN2_CHAT_ID=

# ---------- Appwrite storage (only needed for seller APKs bigger than 45 MB) ----------
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ac861f6001079d0d6e2
# server API key with the "storage" scopes (files.read/write, buckets.read/write). Set it in Render, never commit it.
APPWRITE_API_KEY=your-api-key
# bucket is created automatically on first use if it does not exist
APPWRITE_BUCKET_ID=seller-apks

# ---------- optional ----------
# Render sets RENDER_EXTERNAL_URL automatically. Set BASE_URL for custom domains.
BASE_URL=
ADMIN_CHAT_ID=
TIMEZONE=Asia/Kolkata
MAX_TXN_PER_DAY=5
TXN_TTL_SECONDS=600
# local development only
APP_ENV=production
USE_MEMORY_DB=0
