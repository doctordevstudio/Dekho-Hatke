# ---------- required ----------
SECRET_KEY=change-me-to-a-long-random-string
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# paste the whole service-account JSON on ONE line (Render: Environment -> add variable)
FIREBASE_CREDENTIALS_JSON=
BOT_TOKEN=123456:ABC-your-bot-token

# first admin (only used when the database has no admin yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword1

# optional second admin: can do everything except deleting (created / password synced from env on every start)
ADMIN2_USERNAME=
ADMIN2_PASSWORD=
ADMIN2_CHAT_ID=

# ---------- domain + Cloudflare (see CLOUDFLARE_SETUP.md) ----------
# Turns on sub-domains: admin.<domain>, seller.<domain>, reseller.<domain>, api.<domain>. Leave empty for a single-host setup.
ROOT_DOMAIN=dekhohatke.com
# Same value as the "X-Origin-Auth" request header that the Cloudflare Transform Rule adds. When set, anything that does not
# come through Cloudflare gets 404. Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ORIGIN_SECRET=
# only if you do not use the default names:  ADMIN_HOST= SELLER_HOST= RESELLER_HOST= API_HOST=

# ---------- optional ----------
# Telegram webhook base. Default with ROOT_DOMAIN: https://api.<domain>. Without it: RENDER_EXTERNAL_URL.
BASE_URL=
ADMIN_CHAT_ID=
TIMEZONE=Asia/Kolkata
MAX_TXN_PER_DAY=5
TXN_TTL_SECONDS=600
# local development only
APP_ENV=production
USE_MEMORY_DB=0
